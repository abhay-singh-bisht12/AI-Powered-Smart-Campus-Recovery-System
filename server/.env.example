    MONGODB_URI=
    PORT=5000

    # Used to sign login tokens (set a long random string in production)
    JWT_SECRET=

    # Optional: set to your Vercel domain in production, e.g. https://your-app.vercel.app
    # For local dev you can leave this unset.
    CLIENT_ORIGIN=*

    # Admin seeding (run: npm run seed:admin)
    ADMIN_EMAIL=
    ADMIN_PASSWORD=
    ADMIN_NAME=Admin
